# 環境設定
NODE_ENV=development
APP_PORT=3001
LOG_LEVEL=debug

# データベース（開発用）
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=lumina_cms
DB_USERNAME=developer
DB_PASSWORD=

# データベース（テスト用）
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_DATABASE=lumina_cms_test
TEST_DB_USERNAME=test_developer
TEST_DB_PASSWORD=

# 認証設定
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_PATH=/api/auth

# OAuth Providers（オプション）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# サーバー設定
NEXT_PUBLIC_APP_URL=http://localhost:3000
GLOBAL_API_PREFIX=api

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=Lumina CMS API
SWAGGER_DESCRIPTION=Enterprise Content Management System API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# ミドルウェア設定
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
COOKIE_PARSER_ENABLED=true

# メール（開発用）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@lumina-cms.local

# レート制限
THROTTLE_TTL=60
THROTTLE_LIMIT=100
